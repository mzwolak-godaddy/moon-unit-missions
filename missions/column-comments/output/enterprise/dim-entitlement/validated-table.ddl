CREATE TABLE dim_entitlement(
entitlement_id               string     COMMENT '@PrimaryKey Unique identifier for an entitlement. In Classic eComm System (CES), synthesized from resource_id and product_type_id; in New eComm System (NES), a system-generated UUID.'
,subscription_id             string     COMMENT '@ForeignKey(enterprise.dim_subscription) Subscription identifier linking this entitlement to its parent subscription. One subscription may have multiple entitlements (e.g., hard bundles).'
,resource_id                 bigint     COMMENT 'Resource identifier from the classic eComm system (CES) source billing table. May repeat across entitlement rows for addons (entitlement_addon_flag = true).'
,product_type_id     	       int        COMMENT 'Numeric identifier for the product type (e.g., domain, hosting, email). Sourced from CES gdshop_product_type_snap.'
,product_type_desc   	       string     COMMENT 'Human-readable description of the product type corresponding to product_type_id (e.g., Domain Registration, Web Hosting).'
,product_family_name         string     COMMENT 'Product family grouping for the entitlement (formerly name_space).'
,pf_id                       int        COMMENT '@ForeignKey(gdmastercatalog.catalog_product_snap) Product family identifier referencing the GoDaddy master product catalog.'
,renewal_pf_id               int        COMMENT '@ForeignKey(gdmastercatalog.catalog_product_snap) Product family identifier of the renewal product (what this entitlement renews as).'
,renewal_pf_id_sellable_flag boolean    COMMENT 'Indicates whether the renewal product family (renewal_pf_id) is currently sellable (true/false).'
,entitlement_common_name     string     COMMENT 'Human-readable common name for the entitlement. For many products, the domain name associated with the product when configured.'
,entitlement_external_resource_id string COMMENT 'External resource identifier for the entitlement, typically the Orion ID when the Orion system was still used for product fulfillment.'
,entitlement_create_mst_ts   timestamp  COMMENT 'Timestamp (Mountain Standard Time) when the entitlement was created.'
,entitlement_create_mst_date date       COMMENT 'Date (Mountain Standard Time) when the entitlement was created.'
,entitlement_modify_mst_ts   timestamp  COMMENT 'Timestamp (Mountain Standard Time) of the most recent modification to the entitlement record.'
,entitlement_modify_mst_date date       COMMENT 'Date (Mountain Standard Time) of the most recent modification to the entitlement record.'
,entitlement_obsolete_resource_id bigint COMMENT 'Historically, the resource identifier for fullfillment system that pre-dated Orion. Now populated with CES resource_id and has little to no value.'
,parent_resource_id          bigint     COMMENT 'Resource identifier of the parent subscription that granted a child product. Most commonly, a domain registration that grants free products (e.g., free hosting, free email) via Free Product Packages (FPP).'
,parent_product_type_id      int        COMMENT 'Product type identifier of the parent subscription.'
,free_product_package_id     int        COMMENT 'Identifier for a free product package (FPP) included with this subscription (e.g., free email with domain).'
,domain_id                   bigint     COMMENT 'Domain system numeric identifier for the domain associated with this entitlement.'
,domain_name                 string     COMMENT 'Domain name associated with this entitlement.'
,base_pf_id                  int        COMMENT 'Product family identifier for the shortest-term (typically 1-year) variant of the product. For actively sold products, only used for domains.'
,base_original_list_price_usd_amt decimal(18,2) COMMENT 'Original list price in US dollars for the base product. Only used for domain products.'
,entitlement_addon_id        bigint     COMMENT 'CES addon identifier for add-on product associated with the entitlement.'
,entitlement_addon_flag      boolean    COMMENT 'Indicates whether this entitlement is an add-on product (true/false).'
,exclude_reason_desc         string     COMMENT 'Reason to exclude this row from standard analyses. Null for valid entitlements. Common non-null values: add-on product, Internal Shopper, Acquisition Elimination.'
,source_system_name          string     COMMENT 'Name of the source ecommerce system that originated this entitlement (e.g. legacy e-comm, nes_shim').'
,source_table_name           string     COMMENT 'Name of the CES source database table that provided this entitlement record.'
,entitlement_mst_year        int        COMMENT 'Year (Mountain Standard Time) of the entitlement record. ETL partition key; matches partition_entitlement_mst_year.'
,entitlement_mst_month       int        COMMENT 'Month (Mountain Standard Time) of the entitlement record. ETL partition key; matches partition_entitlement_mst_month.'
,tx_source_database          string     COMMENT 'Source database name from the transaction log feed used for CDC-based ingestion.'
,tx_source_table             string     COMMENT 'Source table name from the transaction log feed used for CDC-based ingestion.'
,tx_action                   string     COMMENT 'Transaction log action type from the CDC feed. @Enumerated(INSERT, UPDATE, DELETE).'
,tx_write_time               timestamp  COMMENT 'Timestamp when the transaction was written to the source transaction log.'
,tx_source_time              timestamp  COMMENT 'Timestamp of the transaction event recorded in the originating source system.'
,tx_date                     string     COMMENT 'String-formatted date of the transaction (YYYY-MM-DD), used for ETL processing window boundaries.'
,etl_build_mst_ts            timestamp  COMMENT 'Audit timestamp (Mountain Standard Time) when the ETL pipeline built and loaded this record into the data lake.'
);
