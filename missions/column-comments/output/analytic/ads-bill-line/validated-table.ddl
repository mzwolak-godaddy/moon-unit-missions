CREATE TABLE ads_bill_line (
    bill_id string COMMENT '@PrimaryKey Unique identifier for a bill (order). Composite primary key with bill_line_num.',
    bill_line_num int COMMENT '@PrimaryKey Line number within a bill identifying a specific billed item. Composite primary key with bill_id.',
    bill_country_code string COMMENT 'ISO country code of the address on the payment instrument used for a paid bill. For bills with no payment, the customer profile country code is used.',
    rep_version_id int COMMENT 'Care representative version identifier on the bill.',
    private_label_id int COMMENT 'Identifier for the private label (reseller or white-label) partner associated with this billing line.',
    bill_isc_source_code string COMMENT 'The internal or internet source code (isc) that attributes the bill to a marketing campaign, email link, affiliate, or channel.',
    bill_sub_geo_code string COMMENT 'Sub-geography code associated with the payment instrument address or customer profile for the bill.',
    bill_postal_code string COMMENT 'Postal code associated with the payment instrument address or customer profile for the bill.',
    bill_source_name string COMMENT 'Point-of-sale channel or purchase origin for this bill line.',
    entered_by_name string COMMENT 'Identifies the entity or role that submitted the order (e.g., customer, billing agent, C3 agent).',
    translation_language_name string COMMENT 'ecords the language of the customer browser or session at the time of purchase. Currently not populated.',
    primary_payment_type_name string COMMENT 'Payment method type for the highest value payment on the bill (e.g. credit card, paypal, instorecredit).',
    primary_payment_subtype_name string COMMENT 'Subtype of the primary payment method on the bill (e.g. mastercard, paypal).',
    secondary_payment_type_name string COMMENT 'Payment method type for the second highest value payment on the bill, if multiple payment methods were used.',
    secondary_payment_subtype_name string COMMENT 'Subtype of the secondary payment method on the bill.',
    bill_payment_processor_name string COMMENT 'Name of the payment processor used for the bill.',
    bill_payment_processor_common_name string COMMENT 'Common display name of the payment processor used for the bill.',
    bill_payment_cpl_trxn_currency_code string COMMENT 'Currency code from the Common Purchase Log (CPL) transaction.',
    bill_payment_cpl_trxn_amt decimal(18,2) COMMENT 'Transaction amount from the CPL transaction.',
    bill_modified_mst_date_prior_year date COMMENT 'Bill modification date in Mountain Standard Time, shifted back one year for year-over-year comparisons.',
    bill_isc_source_code_desc string COMMENT 'Description of the internal or internet source code (isc) that attributes the bill to a marketing campaign, email link, affiliate, or channel.',
    bill_isc_company_id int COMMENT 'Company ID associated with the ISC on the bill.',
    bill_isc_campaign_id int COMMENT 'Campaign ID associated with the ISC on the bill.',
    bill_isc_channel_id int COMMENT 'Channel ID associated with the ISC on the bill.',
    bill_isc_product_id int COMMENT 'Product ID associated with the ISC on the bill.',
    bill_isc_vendor_id int COMMENT 'Vendor ID associated with the ISC on the bill.',
    bill_isc_media_specialist_id int COMMENT 'Media specialist ID associated with the ISC on the bill.',
    bill_isc_sub_channel_id int COMMENT 'Sub-channel ID associated with the ISC on the bill.',
    bill_isc_channel_name string COMMENT 'Marketing channel associated with the ISC on the bill (e.g. Billing Agent, Branding, Legacy).',
    bill_isc_sub_channel_name string COMMENT 'Marketing sub-channel associated with the ISC on the bill (e.g. C3, Bounceback eMail).',
    bill_isc_vendor_name string COMMENT 'Vendor name associated with the ISC on the bill (e.g. Google UK, Internal Affiliate Program, Google Australia)',
    bill_isc_product_name string COMMENT 'Product name associated with the ISC on the bill (e.g. Domains, Miscellaneous, None Specified).',
    bill_isc_media_specialist_name string COMMENT 'Employee PII (encrypted). GoDaddy media specialist name associated with the ISC on the bill.',
    reseller_type_name string COMMENT 'Reseller type of the Private Label ID (PLID) for the bill (e.g. Go Daddy, Pro Reseller, API Reseller).',
    reseller_name string COMMENT 'Name of the private label reseller associated with the bill.',    
    reseller_shopper_id string COMMENT 'Reseller shopper ID associated with the bill. May change as shopper merges occur.',
    reseller_country_code string COMMENT 'Country code of the first paid bill for the reseller shopper ID.',
    reseller_country_name string COMMENT 'Country name of the first paid bill for the reseller shopper ID.',   
    c3_rep_name string COMMENT 'Employee PII (encrypted). Customer Care Center representative name for the bill.',
    c3_rep_supervisor_name string COMMENT 'Employee PII (Encrypted). Supervisor name of the Customer Care Center representative.',
    c3_rep_department_name string COMMENT 'Customer Care Center representative department name.',
    c3_call_center_location_name string COMMENT 'Customer Care Center representative call center location.',
    bill_country_name string COMMENT 'Country name associated with the bill. Sourced from geography dimension with a join on bill_country_code.',
    bill_report_region_1_name string COMMENT 'First-level geographic reporting region associated with the bill. Sourced from geography dimension.',
    bill_report_region_2_name string COMMENT 'Second-level geographic reporting region associated with the bill. Sourced from geography dimension.',
    bill_report_region_3_name string COMMENT 'Third-level geographic reporting region associated with the bill. Sourced from geography dimension.',
    bill_report_focal_country_name string COMMENT 'Focal country name associated with the bill ued for geographic reporting. Sourced from geography dimension.',
    bill_report_sub_region_name string COMMENT 'Sub-region name associated with the bill used for geographic reporting. Sourced from geography dimension.',
    bill_domestic_international_name string COMMENT 'Classification of the bill as domestic or international based on bill country. Sourced from geography dimension.',
    merged_shopper_id string COMMENT 'Current post-merge shopper ID on the bill.',
    original_shopper_id string COMMENT 'Shopper ID at original bill creation.',
    new_registered_user_bill_id string COMMENT 'Bill ID created when the customer initially registered before making any paid purchase. Often associated with a free trial sign up.',
    new_acquisition_bill_country_code string COMMENT 'Bill country code for the first paid purchase by the customer. Set once per customer and includes domain change of account (COA).',
    new_acquisition_bill_id string COMMENT 'Bill ID for the first paid purchase by the customer. Set once per customer and includes domain change of account (COA).',
    new_acquisition_bill_mst_date date COMMENT 'Date in Mountain Standard Time (MST) for the first paid purchase by the customer. Set once per customer and includes domain change of account (COA).',
    new_registered_user_bill_mst_date date COMMENT 'Date in MST for the new registered user (NRU) bill. Set once per customer and excludes COA.',
    federation_partner_id string COMMENT 'Identifier for the federation partner associated with the bill.',
    federation_friendly_name string COMMENT 'Name of the federation partner associated with the bill (e.g. Media Temple, 123 Reg, TSOHost).',
    web_pro_participant_type_name string COMMENT 'For Web Pro bills, indicates whether a Pro or a Client initiated the purchase.',
    web_pro_shopper_id string COMMENT 'Web Pro shopper ID associated with the bill.',    
    original_shopper_exclude_reason_desc string COMMENT 'Reason a bill line is excluded based on the original shopper ID.',
    original_shopper_exclude_reason_month_end_desc string COMMENT 'Reason a bill line is excluded at month-end based on the original shopper ID.',    
    shopper_domain_portfolio_qty int COMMENT 'Number of domains in the customer domain portfolio at the time of the bill.',
    shopper_domain_portfolio_segment_name string COMMENT 'Domain portfolio segment name for the shopper at the time of the bill (e.g. 1 Active Domain, 3-6 Active Domains).',
    crm_portfolio_type_name string COMMENT 'Customer Relationship Management (CRM) portfolio type assigned to the customer at the time of the bill (e.g. Premier Services - Gold, Premier Services - Platinum).',
    crm_portfolio_rep_id int COMMENT 'CRM portfolio care representative ID assigned to the customer as the time of the bill.',
    crm_portfolio_rep_name string COMMENT 'Employee PII (encrypted). CRM portfolio care representative name assigned to the customer at the time of the bill.',
    current_crm_portfolio_type_name string COMMENT 'Current CRM portfolio type assigned to the customer (e.g. Premier Services - Gold, Premier Services - Platinum)',
    current_crm_portfolio_rep_id int COMMENT 'Current CRM portfolio care representative ID assigned to the customer.',
    current_crm_portfolio_rep_name string COMMENT 'Employee PII (encrypted). Current CRM portfolio care representative name assigned to the customer.',
    product_term_num int COMMENT 'Number of billing periods for the product purchased.',
    product_term_unit_desc string COMMENT 'Billing period unit for the product purchased (e.g., month, quarter, year).',
    product_pnl_category_name string COMMENT 'Second level of the Finance-approved Profit and Loss (PnL) product hierarchy.',
    product_pnl_group_name string COMMENT 'First level of the Finance-approved Profit and Loss (PnL) product hierarchy.',
    product_pnl_line_name string COMMENT 'Third level of the Finance-approved Profit and Loss (PnL) product hierarchy.',
    product_pnl_subline_name string COMMENT 'Fourth level of the Finance-approved Profit and Loss (PnL) product hierarchy.',
    product_pnl_version_name string COMMENT 'Flexible pseudo-level of the Finance-approved Profit and Loss (PnL) hierarchy.',
    original_product_pnl_new_renewal_name string COMMENT 'Identifies the product (pf_id) as a new purchase or renewal.',
    product_type_desc string COMMENT 'Product type description for the product (not necessarily related to the PnL hierarchy).',
    product_type_id double COMMENT 'Product type ID for the product (not necessarily related to the PnL hierarchy).',
    product_name string COMMENT 'Product name associated with the purchased product (pf_id).',
    pnl_new_renewal string COMMENT 'New or renewal designation for this product (pf_id).',
    bill_fraud_flag_ts timestamp COMMENT 'Timestamp when this bill was flagged as fraudulent by the fraud team.',
    bill_fraud_flag_date date COMMENT 'Date when this bill was flagged as fraudulent by the fraud team.',
    bill_fraud_review_id int COMMENT 'Fraud review ID under which this bill was flagged as fraudulent.',
    free_trial_type_desc string COMMENT 'Description of the free trial type associated with the bill line.',
    free_trial_target_expiration_date date COMMENT 'Target expiration date of the free trial associated with the bill line.',
    product_free_trial_acquisition_ts timestamp COMMENT 'Timestamp of the original free trial bill. For products with tier changes, subsequent bills reflect this original timestamp.',
    original_bill_id string COMMENT 'For refunds or chargebacks, the ID of the original bill that was refunded or charged back.',
    original_bill_line_num int COMMENT 'For refunds or chargebacks, the line number of the original bill line that was refunded or charged back.',
    source_system_name string COMMENT 'Originating system name for this record (e.g., legacy e-comm for Classic eComm System (CES)).',
    bill_modified_mst_ts timestamp COMMENT 'Bill timestamp converted to Mountain Standard Time (MST) representing the creation or last modified time of the bill.',
    bill_modified_mst_date date COMMENT 'Bill date in Mountain Standard Time (MST) representing the creation or last modified date of the bill.',    
    subaccount_shopper_id string COMMENT 'Shopper ID for the subaccount associated with this bill line. Used primarily to identify the customer for API reseller bills.',
    item_tracking_code string COMMENT 'Item tracking code (itc) for the billed item. Identifies where on the GoDaddy site the customer was when the product was added to cart, or which team/process was responsible for adding it.',
    item_tracking_code_desc string COMMENT 'Tracking code (ITC) that identifies where on the website a product was added to the shopping cart or the team or process that generated the bill.',
    purchase_path_name string COMMENT 'Website location where the product was added to the shopping cart (e.g. Domain Purchase Path, Renewals, My Account).',
    purchase_path_attributed_name string COMMENT 'Attributed purchase path. For Cart New Purchase rows, uses the first non-Cart purchase path for the bill_id; otherwise equals purchase_path_name.',
    department_id int COMMENT 'Identifier of the business department responsible for this billing line item. Defined by accounting and finance.',
    accounting_company_id int COMMENT 'Accounting company identifier that represents the GoDaddy legal entity (subsidiary) used to process the transaction for tax calculation and financial reporting purposes.',
    pf_id int COMMENT 'Product family identifier for the product purchased.',
    upgraded_pf_id int COMMENT 'Product Family identifier that captures the pf_id of the product the customer is upgrading from when an order represents a product tier upgrade. Legacy column that may not track all product upgrades.',
    unit_qty int COMMENT 'Number of units purchased for this line item.',
    duration_qty decimal(18,3) COMMENT 'Number of subscription period units (e.g., months or years) for this line item.',
    product_unit_qty int COMMENT 'Unit quantity adjusted for products sold as single units: 1 if the product is configured as units-as-orders, otherwise equals unit_qty.',
    product_month_qty decimal(18,2) COMMENT 'Number of calendar months in the subscription period (e.g., month=1, year=12, quarter=3). Converts the product billing term into a monthly equivalent.',
    receipt_price_usd_amt decimal(18,2) COMMENT 'Amount paid for the bill line item in US dollars (USD) after discounts.',
    receipt_price_trxn_amt decimal(18,2) COMMENT 'Amount paid for the bill line item in the transaction currency after discounts.',
    receipt_price_constant_currency_amt decimal(18,2) COMMENT 'Amount paid for the bill line item using a constant foreign exchange rate (USD) to enable year-over-year trending without currency fluctuations.',
    gcr_usd_amt decimal(18,2) COMMENT 'Gross Cash Receipts (GCR) for this line item in US dollars (USD). Derived: fair_market_value + item_subtotal - ICANN fee - injected fair market value - injected ICANN fee.',
    gcr_trxn_amt decimal(18,2) COMMENT 'GCR for this line item in the transaction currency. Derived: fair_market_value + item_subtotal - ICANN fee - injected FMV - injected ICANN fee.',
    gcr_constant_currency_amt decimal(18,2) COMMENT 'GCR using a constant foreign exchange rate (USD) to enable year-over-year trending without currency fluctuations.',
    margin_gcr_usd_amt decimal(18,2) COMMENT 'GCR margin for this line item in US dollars (USD) after substracting cost of goods sold. Note that cost is an approximation for domains and is not accurate for non-domain products.',
    margin_gcr_trxn_amt decimal(18,2) COMMENT 'GCR margin for this line item in the transaction currency after subsracting cost of good sold. Note that cost is an approximation for domains and is not accurate for non-domain products.',
    commission_usd_amt decimal(18,2) COMMENT 'Represents the amount in US dollars (USD) owed to a third-party sales channel (reseller, affiliate, or care agent) for driving or processing the transaction.',
    commission_trxn_amt decimal(18,2) COMMENT 'Represents the amount in the transaction currency owed to a third-party sales channel (reseller, affiliate, or care agent) for driving or processing the transaction.',
    aftermarket_seller_commission_usd_amt decimal(18,2) COMMENT 'Commission paid to the domain aftermarket seller in US dollars (USD). Derived: fair market value minus auction commission when commission_product_flag=1, else zero.',
    aftermarket_seller_commission_trxn_amt decimal(18,2) COMMENT 'Commission paid to the domain aftermarket seller in the transaction currency. Fair market value minus auction commission when commission_product_flag=1, else zero.',
    cost_usd_amt decimal(18,2) COMMENT 'Cost of goods sold for this line item in US dollars (USD). Note that cost is an approximation for domains and is not accurate for non-domain products.',
    cost_trxn_amt decimal(18,2) COMMENT 'Cost of goods sold for this line item in the transaction currency. Note that cost is an approximation for domains and is not accurate for non-domain products.',
    msrp_duration_unit_usd_amt decimal(18,2) COMMENT 'List price associated with a single billing-period unit of the order line item in USD. Represents what the product should cost at its standard price for the duration and quantity purchased, including ICANN fees for domain products.',
    msrp_duration_unit_trxn_amt decimal(18,2) COMMENT 'List price associated with a single billing-period unit of the order line item in the transaction currency. Represents what the product should cost at its standard price for the duration and quantity purchased, including ICANN fees for domain products.',
    msrp_total_usd_amt decimal(18,2) COMMENT 'List price of the products purchased on the  bill line in USD. Represents the full standard price absent any promotions or discounts and accounts for quantity, duration, and ICANN fee.',
    msrp_total_trxn_amt decimal(18,2) COMMENT 'List price of the products purchased on the  bill line in the transaction currency. Represents the full standard price absent any promotions or discounts and accounts for quantity and ICANN fee.',
    fee_usd_amt decimal(18,2) COMMENT 'Fee in USD for the bill line. Typically the ICANN fee for a domain purchase but could include other fees in future.',
    fee_trxn_amt decimal(18,2) COMMENT 'Fee in the transaction currency for the bill line. Typically the ICANN fee for a domain purchase but could include other fee in future.',
    fair_market_value_usd_amt decimal(18,2) COMMENT 'Fair market value (FMV) of this line item in USD. FMV is the relative standalone selling price of each product used to determine how much revenue can be recognized (and when) and exists even when the customer paid nothing.',
    fair_market_value_trxn_amt decimal(18,2) COMMENT 'Fair market value (FMV) of this line item in the transaction currency. FMV is the relative standalone selling price of each product used to determine how much revenue can be recognized (and when) and exists even when the customer paid nothing.',    
    tax_usd_amt decimal(18,2) COMMENT 'Tax amount charged for this line item in USD.',
    tax_trxn_amt decimal(18,2) COMMENT 'Tax amount charged for this line item in the transaction currency.',
    receipt_regular_price_usd_amt decimal(18,2) COMMENT 'Current selling price in USD for the line item. Price customer actually pays can be different due to promotions. Accounts for quantity, duration, and ICANN fee.',
    receipt_regular_price_trxn_amt decimal(18,2) COMMENT 'Current selling price in the transaction currency for the line item. Price customer actually pays can be different due to promotions. Accounts for quantity, duration, and ICANN fee.',    
    injected_fair_market_value_usd_amt decimal(18,2) COMMENT 'System-injected fair market value adjustment for this line item in USD. Injection refers to a scenario where an order was initiated externally (e.g. Office Depot external partner collected monies but promotion was redeemed at GoDaddy)',
    injected_fair_market_value_trxn_amt decimal(18,2) COMMENT 'System-injected fair market value adjustment for this line item in the transaction currency. Injection refers to a scenario where an order was initiated externally (e.g. Office Depot external partner collected monies but promotion was redeemed at GoDaddy)',
    injected_icann_fee_usd_amt decimal(18,2) COMMENT 'System-injected ICANN regulatory fee for this line item in USD.',
    injected_icann_fee_trxn_amt decimal(18,2) COMMENT 'System-injected ICANN regulatory fee for this line item in the transaction currency.',
    injected_tax_usd_amt decimal(18,2) COMMENT 'System-injected tax amount for this line item in USD.',
    injected_tax_trxn_amt decimal(18,2) COMMENT 'System-injected tax amount for this line item in the transaction currency.',
    bundle_allocated_revenue_usd_amt decimal(18,2) COMMENT 'Revenue allocated for this line item within a bundle representing the share of the total bundle revenue in USD.',
    reseller_commission_usd_amt decimal(18,2) COMMENT 'Amount of commission earned by the reseller in USD.',
    parent_reseller_commission_usd_amt decimal(18,2) COMMENT 'Amount of commission earned by the parent reseller in USD.',
    trxn_currency_code string COMMENT 'ISO 4217 currency code for the transaction (e.g., USD, EUR, GBP, CAD).',
    offer_id int COMMENT 'Identifier for the bundle that this product was included in. Bundles are groups of products that are sold together. Extrapolated from bundle_id in Classic eComm System (CES).',
    offer_collection_id int COMMENT 'Identifier for the parent offer collection this line item belongs to. Extrapolated from parent_bundle_id in CES.',
    free_product_package_id int COMMENT 'Identifier for the free product package associated with this line item. A free product package is a group of products that are included for free when a product is purchased.',
    variant_price_type_id int COMMENT 'Identifier for the variant price type which is a lever that the pricing team has that allows prices changes based on customer membership or discount eligibility (e.g. Standard Price, GoDaddy Pro Member Price).',
    variant_price_type_name string COMMENT 'Name for the variant price type which is a lever that the pricing team has that allows prices changes based on customer membership or discount eligibility (e.g. Standard Price, GoDaddy Pro Member Price).',
    exclude_reason_desc string COMMENT 'Description of the reason this line item is excluded from reporting, if applicable (e.g. Acquisition Elimination, ATMP).',
    exclude_reason_month_end_desc string COMMENT 'Month-end specific exclusion reason for this line item, if applicable (e.g. Acquisition Elimination, Excluded pf_id).',
    item_discount_code string COMMENT 'Discount code applied to this line item at time of purchase, if any.',
    intent string COMMENT 'Intent classification for virtual bill line items indicating the type of no-charge transaction (e.g. FREEMIUM_PURCHASE, FREE_PURCHASE, FREE_TRIAL_MODIFY).',
    related_subscription string COMMENT 'Subscription identifier linking a receiptless or virtual order event to a specific customer subscription.',
    bill_site_language_code string COMMENT 'Language locale code of the website where the bill was placed (e.g. en-us, en-gb, en-ca). Defaults to Missing when null.',
    c3_bill_source_code string COMMENT 'Code indicating how the Customer Care Center (C3) attributed the bill.',
    c3_bill_process_name string COMMENT 'Describes how the Customer Care Center (C3) attributed the bill (e.g. Call Center, Web, DelayedPayment).',
    free_trial_bill_type string COMMENT 'Bill type for the free trial billr associated with this bill line (e.g. virtual, standard).',
    free_trial_bill_date date COMMENT 'Date of the free trial bill associated with the bill line.',
    virtual_bill_flag boolean COMMENT 'Indicates whether this is a virtual or receiptless bill (true/false) that has no associated payment.',
    free_bill_flag boolean COMMENT 'Flag indicating whether on not there was any GCR on the bill. The flag is true when no GCR (excluding ICANN fees) is associated with the entire bill, otherwise false.',
    bill_isc_viral_flag boolean COMMENT 'True if the Internet Source Code (ISC) for the bill is classified as viral marketing and received viral pricing.',    
    new_acquisition_flag boolean COMMENT 'True if bill was 1st paid customer purchase. For shopper merges, gaining shopper will have two bill_ids marked as true to preserve historical new customer counts. As such, customer counts should count(distinct bill_id) where new_acquisition_flag=true).',
    new_registered_user_flag boolean COMMENT 'True when for bills where the customer initially registered before making any paid purchase. Often associated with a free trial sign up.',
    product_free_term_flag boolean COMMENT 'True for products given free for the first billing period but paid thereafter (e.g., O365 1 Month Free, WSB 1 Month Free).',
    units_as_bills_flag boolean COMMENT 'True if the purchase is for 1 resource regardless of quantity; False if unit_qty represents number of resources. Use product_unit_qty for actual unit count.',
    primary_product_flag boolean COMMENT 'True for primary products (e.g., hosting); False for add-on products (e.g., disk space add-ons).',
    c3_receipt_move_flag boolean COMMENT 'True if this bill was attributed to the Customer Care Center (C3) retroactively.',
    product_free_trial_flag boolean COMMENT 'True for bills that initiated a free trial product subscription.',
    product_free_trial_conversion_flag boolean COMMENT 'True if this product converted from a free trial to a paid product on the bill.',
    refund_flag boolean COMMENT 'Indicates whether this bill line is a refund transaction (true/false). Derived from the presence of R in bill_id.',
    chargeback_flag boolean COMMENT 'Indicates whether this bill line is a chargeback transaction (true/false). Derived from the presence of C in bill_id.',    
    accounting_deferred_flag boolean COMMENT 'True when revenue on the bill is deferred to a subsequent accounting period and false when revenue is recognized in the current accounting period.',
    renewal_price_locked_flag boolean COMMENT 'Indicates whether the renewal price is locked for future renewal periods (true/false).',
    bill_fraud_flag boolean COMMENT 'True if this bill was flagged as fraudulent by the fraud team. Also True for virtual orders if the shopper was deemed fraudulent.',
    c3_bill_flag boolean COMMENT 'True if the bill is attributed to a Customer Care Center (C3) representative.',
    c3_attribution_type_name string COMMENT 'Customer Care Center (C3) revenue attribution type associated with the bill (e.g. Direct, Contact History).',
    product_pnl_new_renewal_name string COMMENT 'Identifies the product (pf_id) as a new purchase or renewal.',
    customer_type_name string COMMENT 'Customer type classification assigned to the customer at the time of the bill.',
    customer_type_reason_desc string COMMENT 'Reason for the customer type classification assigned to the customer at the time of the bill.',
    original_customer_id string COMMENT 'Customer ID at original bill creation.',
    merged_customer_id string COMMENT 'Current post-merge Customer ID on the bill.',
    domain_bulk_flag boolean COMMENT 'True if total non-refund, non-chargeback domain registration unit quantity for this bill ID is >= 50.',    
    domain_bulk_pricing_flag boolean COMMENT 'True if the product type ID is 4 or 5 (domain bulk pricing product types).',
    domain_back_end_registry_name string COMMENT 'Back-end registry name for the top-level domain (TLD) on the bill (e.g. VERISIGN, Identity Digital, GoDaddy Registry).',
    domain_front_end_registry_name string COMMENT 'Front-end registry name for the domain top-level domain (TLD) on the bill (e.g. VERISIGN, PIR, Identity Digital).',
    domain_registry_family_name string COMMENT 'Registry family name for the top-level domain (TLD) on the bill (e.g. VERISIGN, PIR, Afilias).',
    domain_parent_tld_name string COMMENT 'Parent top-level domain (TLD) name for the domain on this order (e.g. COM, NET, ORG).',    
    pnl_priority_num int COMMENT 'Priority number from the customer type GCR logic lookup, used to rank PnL segment assignment.',
    pnl_usi_flag boolean COMMENT 'True if the bill is associated with the USI (US Independent) PnL segment.',
    pnl_gdii_flag boolean COMMENT 'True if the bill is associated with the GDII (GoDaddy International Independent) PnL segment.',
    pnl_partner_flag boolean COMMENT 'True if the bill is associated with the Partner PnL segment.',
    pnl_dri_flag boolean COMMENT 'True if the bill is associated with the DRI (Domain Registrar and Investor) PnL segment.',
    pnl_commerce_flag boolean COMMENT 'True if the bell is associated with the Commerce PnL segment.',
    point_of_purchase_name string COMMENT 'Point of purchase derived from source_system_name, entered_by_name, and bill_source_name (e.g. Web, Billing Agent, C3, Third Party App Stores).',
    sub_point_of_purchase_name string COMMENT 'Sub-category of the point of purchase for the bill (e.g. Web non-Care-initiated, Billing Agent, United States, International, Web Care-initiated, Third Party App Stores).',
    shopper_product_purchase_type_name string COMMENT 'Customer purchase type for the bill line (e.g. Existing - Buying More, New - New, Existing - New, Not a Customer).',
    etl_build_mst_ts timestamp COMMENT 'Timestamp in MST when the record was first inserted by the ETL process.',
    source_process_name string COMMENT 'Name of the ETL process used to load the record into the table.',
    free_bill_line_flag boolean COMMENT 'True for a non-virtual bill line where both the receipt price amount and GCR are zero.',
    free_bill_line_with_fair_market_value_flag boolean COMMENT 'True for a non-virtual, non-bundle-child bill line where the receipt price amount is zero but GCR is greater than zero.'
);
