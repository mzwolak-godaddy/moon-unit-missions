CREATE TABLE fact_bill_line_vw (
    bill_id string COMMENT '@PrimaryKey Unique identifier for a bill (order). Composite primary key with bill_line_num.',
    bill_line_num int COMMENT '@PrimaryKey Line number within a bill identifying a specific billed item. Composite primary key with bill_id.',
    original_bill_id string COMMENT 'Original bill identifier used to trace modifications or refunds to the source transaction.',
    original_bill_line_num int COMMENT 'Original line number from the source bill, used for tracing refunds or modifications.',
    event_id string COMMENT 'Identifier for the Event Bus Platform event that generated this bill line.',
    source_system_name string COMMENT 'Originating system name for this record (e.g., legacy e-comm for Classic eComm System (CES)).',
    bill_modified_mst_ts timestamp COMMENT 'Bill timestamp converted to Mountain Standard Time (MST) representing the creation or last modified time of the bill.',
    bill_modified_mst_date date COMMENT 'Bill date in Mountain Standard Time (MST) representing the creation or last modified date of the bill.',
    subaccount_customer_id string COMMENT 'Customer identifier for the subaccount associated with this bill line. Used primarily to identify the customer for API reseller bill.',
    refund_flag boolean COMMENT 'Indicates whether this bill line is a refund transaction (true/false). Derived from the presence of R in bill_id.',
    chargeback_flag boolean COMMENT 'Indicates whether this bill line is a chargeback transaction (true/false). Derived from the presence of C in bill_id.',
    item_tracking_code string COMMENT 'Item tracking code (itc) for the billed item. Identifies where on the GoDaddy site the customer was when the product was added to cart, or which team/process was responsible for adding it.',
    department_id int COMMENT 'Identifier of the business department responsible for this billing line item. Defined by accounting and finance.',
    accounting_company_id int COMMENT 'Accounting company identifier that represents the GoDaddy legal entity (subsidiary) used to process the transaction for tax calculation and financial reporting purposes.',
    accounting_deferred_flag boolean COMMENT 'Indicates whether revenue recognition is deferred for this line item (true/false).',
    pf_id int COMMENT '@ForeignKey(dim_product) Product Family identifier for the billed product.',
    product_uri string COMMENT 'Uniform Resource Identifier (URI) for the billed product. Currently not populated; reserved for future use.',
    upgraded_pf_id int COMMENT 'Product Family identifier that captures the pf_id of the product the customer is upgrading from when an order represents a product tier upgrade. Legacy column that may not track all product upgrades.',
    private_label_id int COMMENT 'Identifier for the private label (reseller or white-label) partner associated with this billing line.',
    bill_country_code string COMMENT 'ISO country code of the address on the payment instrument used for a paid bill.',
    bill_sub_geo_code string COMMENT 'State or province code of the address on the payment instrument used for a paid bill.',
    bill_postal_code string COMMENT 'Postal or ZIP code of the address on the payment instrument used for a paid bill.',
    bill_source_name string COMMENT 'Point-of-sale channel or purchase origin for this billing line. Maps from order_point_of_purchase in ecomm_unified_order_event_cln.',
    primary_payment_type_name string COMMENT 'Payment method type for the highest value payment on the bill (e.g. credit card, paypal, instorecredit).',
    primary_payment_subtype_name string COMMENT 'Subtype of the primary payment method on the bill (e.g. mastercard, paypal).',
    secondary_payment_type_name string COMMENT 'Payment method type for the second highest value payment on the bill, if multiple payment methods were used.',
    secondary_payment_subtype_name string COMMENT 'Subtype of the secondary payment method on the bill.',
    order_site_language_code string COMMENT 'Language locale code of the website where the bill was placed (e.g. en-us, en-gb, en-ca). Defaults to Missing when null.',
    translation_language_name string COMMENT 'Records the language of the customer browser/session at the time of purchase. Currently not populated.',
    free_order_flag boolean COMMENT 'Indicates whether this is a zero-charge bill (true/false). True when Gross Cash Receipts (GCR) minus fees per bill is not positive and not a refund or chargeback.',
    bill_isc_source_code string COMMENT 'The internal or internet source code (isc) that attributes the bill to a marketing campaign, email link, affiliate, or channel.',
    virtual_order_flag boolean COMMENT 'Indicates whether this is a virtual\receiptless bill (true/false) that have no associated payment.',
    unit_qty int COMMENT 'Number of units purchased for this line item.',
    duration_qty int COMMENT 'Number of subscription period units (e.g., months or years) for this line item.',
    product_unit_qty int COMMENT 'Unit quantity adjusted for products sold as single units: 1 if the product is configured as units-as-orders, otherwise equals unit_qty.',
    product_month_qty int COMMENT 'Number of calendar months in the subscription period (e.g., month=1, year=12, quarter=3). Converts the product billing term into a monthly equivalent.',
    entered_by_name string COMMENT 'Identifies the entity or role that submitted the order (e.g., customer, billing agent, C3 agent).',
    bill_friendly_id string COMMENT 'Human-readable friendly identifier for the bill. Currently not populated; reserved for future use.',
    receipt_price_usd_amt double COMMENT 'Amount paid for the bill line item in US dollars (USD) after discounts.',
    receipt_price_trxn_amt double COMMENT 'Amount paid for the bill line item in the transaction currency after discounts.',
    gcr_usd_amt double COMMENT 'Gross Cash Receipts (GCR) for this line item in US dollars (USD). Derived: fair_market_value + item_subtotal - ICANN fee - injected fair market value - injected ICANN fee.',
    gcr_trxn_amt double COMMENT 'GCR for this line item in the transaction currency. Derived: fair_market_value + item_subtotal - ICANN fee - injected FMV - injected ICANN fee.',
    margin_gcr_usd_amt double COMMENT 'GCR margin for this line item in US dollars (USD) after substracting cost of goods sold. Note that cost is an approximation for domains and is not accurate for non-domain products.',
    margin_gcr_trxn_amt double COMMENT 'GCR margin for this line item in the transaction currency after subsracting cost of good sold. Note that cost is an approximation for domains and is not accurate for non-domain products.',
    commission_usd_amt double COMMENT 'Represents the amount in US dollars (USD) owed to a third-party sales channel (reseller, affiliate, or care agent) for driving or processing the transaction.',
    commission_trxn_amt double COMMENT 'Represents the amount in the transaction currency owed to a third-party sales channel (reseller, affiliate, or care agent) for driving or processing the transaction.',
    aftermarket_seller_commission_usd_amt double COMMENT 'Commission paid to the domain aftermarket seller in US dollars (USD). Derived: fair market value minus auction commission when commission_product_flag=1, else zero.',
    aftermarket_seller_commission_trxn_amt double COMMENT 'Commission paid to the domain aftermarket seller in the transaction currency. Fair market value minus auction commission when commission_product_flag=1, else zero.',
    cost_usd_amt double COMMENT 'Cost of goods sold for this line item in US dollars (USD). Note that cost is an approximation for domains and is not accurate for non-domain products.',
    cost_trxn_amt double COMMENT 'Actual cost of goods sold for this line item in the transaction currency. Note that cost is an approximation for domains and is not accurate for non-domain products.',
    msrp_duration_unit_usd_amt double COMMENT 'List price associated with a single billing-period unit of the order line item in USD. Represents what the product should cost at its standard (non-promotional) price for the duration and quantity purchased, including ICANN fees for domain products.',
    msrp_duration_unit_trxn_amt double COMMENT 'List price associated with a single billing-period unit of the order line item in the transaction currency. Represents what the product should cost at its standard (non-promotional) price for the duration and quantity purchased, including ICANN fees for domain products.',
    msrp_total_usd_amt double COMMENT 'List price of the products purchased on the  bill line in USD. Represents the full standard price absent any promotions or discounts and accounts for quantity, duration, and ICANN fee.',
    msrp_total_trxn_amt double COMMENT 'List price of the products purchased on the  bill line in the transaction currency. Represents the full standard price absent any promotions or discounts and accounts for quantity and ICANN fee.',
    fee_usd_amt double COMMENT 'Fee in USD for the bill line. Typically the ICANN fee for a domain purchase but could include other fees in future.',
    fee_trxn_amt double COMMENT 'Fee in the transaction currency for the bill line. Typically the ICANN fee for a domain purchase but could include other fee in future.',
    fair_market_value_usd_amt double COMMENT 'Fair market value (FMV) of this line item in USD. FMV is the relative standalone selling price of each product used to determine how much revenue can be recognized (and when) and exists even when the customer paid nothing.',
    fair_market_value_trxn_amt double COMMENT 'Fair market value (FMV) of this line item in the transaction currency. FMV is the relative standalone selling price of each product used to determine how much revenue can be recognized (and when) and exists even when the customer paid nothing.',
    tax_usd_amt double COMMENT 'Tax amount charged for this line item in USD.',
    tax_trxn_amt double COMMENT 'Tax amount charged for this line item in the transaction currency.',
    receipt_regular_price_usd_amt double COMMENT 'Current selling price in USD for the line item. Price customer actually pays can be different due to promotions. Accounts for quantity, duration, and ICANN fee.',
    receipt_regular_price_trxn_amt double COMMENT 'Current selling price in the transaction currency for the line item. Price customer actually pays can be different due to promotions. Accounts for quantity, duration, and ICANN fee.',
    injected_fair_market_value_usd_amt double COMMENT 'System-injected fair market value adjustment for this line item in USD. Injection refers to a scenario where an order was initiated externally (e.g. Office Depot external partner collected monies but promotion was redeemed at GoDaddy)',
    injected_fair_market_value_trxn_amt double COMMENT 'System-injected fair market value adjustment for this line item in the transaction currency. Injection refers to a scenario where an order was initiated externally (e.g. Office Depot external partner collected monies but promotion was redeemed at GoDaddy)',
    injected_icann_fee_usd_amt double COMMENT 'System-injected ICANN regulatory fee for this line item in USD.',
    injected_icann_fee_trxn_amt double COMMENT 'System-injected ICANN regulatory fee for this line item in the transaction currency.',
    injected_tax_usd_amt double COMMENT 'System-injected tax amount for this line item in USD.',
    injected_tax_trxn_amt double COMMENT 'System-injected tax amount for this line item in the transaction currency.',
    bundle_allocated_revenue_usd_amt double COMMENT 'Revenue allocated for this line item within a bundle representing the share of the total bundle revenue in USD.',
    reseller_commission_usd_amt double COMMENT 'Amount of commission earned by the reseller in USD.',
    parent_reseller_commission_usd_amt double COMMENT 'Amount of commission earned by the parent reseller in USD.',
    trxn_currency_code string COMMENT 'ISO 4217 currency code for the transaction (e.g., USD, EUR, GBP, CAD).',
    renewal_price_locked_flag boolean COMMENT 'Indicates whether the renewal price is locked for future renewal periods (true/false).',
    offer_id int COMMENT 'Identifier for the bundle that this product was included in. Bundles are groups of products that are sold together. Extrapolated from bundle_id in Classic eComm System (CES)',
    offer_collection_id int COMMENT 'Identifier for the parent offer collection this line item belongs to. Extrapolated from parent_bundle_id in CES.',
    free_product_package_id int COMMENT 'Identifier for the free product package associated with this line item. A free product package is a group of products that are included for free when a product is purchased.',
    variant_price_type_id int COMMENT 'Identifier for the variant price type which is a lever that the pricing team has that allows prices changes based on customer membership or discount eligibility (e.g. Standard Price, GoDaddy Pro Member Price).',
    exclude_reason_desc string COMMENT 'Description of the reason this line item is excluded from reporting, if applicable (e.g. Acquisition Elimination, ATMP).',
    exclude_reason_month_end_desc string COMMENT 'Month-end specific exclusion reason for this line item, if applicable (e.g. Acquisition Elimination, Excluded pf_id)',
    list_price_usd_amt double COMMENT 'Original undiscounted product list price for this line item in USD. Includes ICANN fee.',
    list_price_trxn_amt double COMMENT 'Original undiscounted product list price for this line item in the transaction currency. Includes ICANN fee.',
    sale_price_usd_amt double COMMENT 'Current selling price in USD for the line item at the time of purchase. May reflect sale pricing from the pricing catalog but does not include order promotional discounts.',
    sale_price_trxn_amt double COMMENT 'Current selling price in the transaction currency for the line item at the time of purchase. May reflect sale pricing from the pricing catalog but does not include order promotional discounts.',
    item_subtotal_usd_amt double COMMENT 'Line item amount in USD post-discounts, inclusive of ICANN fees, exclusive of taxes.',
    item_subtotal_trxn_amt double COMMENT 'Line item amount in the transaction currency post-discounts, inclusive of ICANN fees, exclusive of taxes.',
    product_list_price_usd_amt double COMMENT 'Per-unit current product list price in US dollars (USD), not multiplied by quantity or period.',
    product_list_price_trxn_amt double COMMENT 'Per-unit current product list price in the transaction currency, not multiplied by quantity or period.',
    variant_price_type_name string COMMENT 'Name for the variant price type which is a lever that the pricing team has that allows prices changes based on customer membership or discount eligibility (e.g. Standard Price, GoDaddy Pro Member Price).',
    item_tracking_code_desc string COMMENT 'Tracking code (ITC) that identifies where on the website a product was added to the shopping cart or the team or process that generated the bill.',
    purchase_path_name string COMMENT 'Identifies where on the website a product was added to the shopping cart prior to purchase.',
    parent_bill_id string COMMENT 'Bill identifier of the parent transaction, if this line item is a child of a parent bill.',
    child_bill_id string COMMENT 'Bill identifier of a child transaction spawned from this bill record, if applicable.',
    item_discount_code string COMMENT 'Discount code applied to this line item at time of purchase, if any.',
    free_trial_flag boolean COMMENT 'Indicates whether this bill line is part of a free trial (true/false).',
    intent string COMMENT 'Intent classification for virtual bill line items indicating the type of no-charge transaction (e.g. FREEMIUM_PURCHASE, FREE_PURCHASE, FREE_TRIAL_MODIFY).',
    related_subscription string COMMENT 'Subscription identifier linking a receiptless or virtual order event to a specific customer subscription.',
    etl_insert_utc_ts timestamp COMMENT 'Timestamp when this record was first inserted by the ETL process (UTC, ISO 8601).',
    etl_update_utc_ts timestamp COMMENT 'Timestamp when this record was last updated by the ETL process (UTC, ISO 8601).'
);
